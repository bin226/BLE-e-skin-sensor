page {
    background: linear-gradient(180deg, #f8fafc 0%, #e2e8f0 100%);
    min-height: 100vh;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.container {
    padding: 8px 8px;
    max-width: 750rpx;
    margin: 0 auto;
}

/* Chart Card */
.chart-card {
    background: #fff;
    border-radius: 12px;
    padding: 12px;
    margin-bottom: 12px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    overflow: hidden;
}

.card-title {
    color: #1e293b;
    font-size: 26rpx;
    font-weight: 600;
    margin-bottom: 10px;
    padding-left: 8px;
    border-left: 3px solid #667eea;
}

.chart-wrapper {
    background: #f8fafc;
    border-radius: 8px;
    padding: 4px;
    margin-bottom: 10px;
}

.current-data {
    display: flex;
    justify-content: space-around;
    gap: 10px;
}

.data-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border-radius: 10px;
    padding: 12px 16px;
    flex: 1;
}

.data-label {
    color: rgba(255, 255, 255, 0.9);
    font-size: 20rpx;
    margin-bottom: 4px;
}

.data-value {
    color: #fff;
    font-size: 28rpx;
    font-weight: 700;
}

/* Output Card */
.output-card {
    background: #fff;
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 14px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    overflow: hidden;
}

.section-label {
    color: #64748b;
    font-size: 22rpx;
    margin-bottom: 8px;
    font-weight: 600;
}

.binary-section {
    margin-bottom: 14px;
    padding-bottom: 14px;
    border-bottom: 1px solid #e2e8f0;
}

.binary-data {
    background: #0f172a;
    color: #22d3ee;
    font-family: 'Monaco', 'Consolas', monospace;
    font-size: 24rpx;
    padding: 12px;
    border-radius: 8px;
    word-break: break-all;
    line-height: 1.5;
}

.text-section {
    margin-bottom: 0;
}

.text-data {
    background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
    color: #166534;
    font-size: 32rpx;
    font-weight: 700;
    padding: 14px;
    border-radius: 8px;
    min-height: 56rpx;
    word-break: break-all;
}

/* Status Card */
.status-card {
    background: #fff;
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 16px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    overflow: hidden;
}

.status-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.status-item {
    display: flex;
    flex-direction: column;
    background: #f8fafc;
    border-radius: 8px;
    padding: 12px 14px;
    flex: 1;
    min-width: 130rpx;
}

.status-label {
    color: #64748b;
    font-size: 20rpx;
    margin-bottom: 6px;
}

.status-value {
    color: #1e293b;
    font-size: 26rpx;
    font-weight: 600;
}

.suppressed-yes {
    color: #f59e0b;
}

.suppressed-no {
    color: #10b981;
}
